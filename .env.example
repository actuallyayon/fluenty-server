# MongoDB Atlas connection string (must include database name, e.g. /fluenty?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fluenty?retryWrites=true&w=majority

# Better Auth Configuration
BETTER_AUTH_SECRET=super_secret_at_least_32_characters_random_string
BETTER_AUTH_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Google OAuth (Optional in early dev, required for Google Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin Seed Account
ADMIN_EMAIL=admin@fluenty.com
ADMIN_PASSWORD=AdminStrongPassword123!

# Stripe (Phase 8)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# imgbb API (Phase 8)
IMGBB_API_KEY=

# Google Gemini (Phase 5)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
